{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omp-X",
  "version": "0.1.0",
  "identifier": "dev.omp.x",
  "build": {
    "frontendDist": "../../../src",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "omp-X",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "store": {
      "autoSave": true
    }
  }
}